{
  "name": "one-week-in-cornwall",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "data:towns": "node scripts/towns.mjs",
    "data:dogs": "node scripts/dogs.mjs",
    "data:lifeguards": "node scripts/lifeguards.mjs",
    "data:beaches": "node scripts/beaches.mjs",
    "data:images": "node scripts/images.mjs",
    "data:describe": "node scripts/describe.mjs",
    "data:report": "node scripts/report.mjs",
    "data": "npm run data:towns && npm run data:dogs && npm run data:lifeguards && npm run data:beaches && npm run data:attractions && npm run data:images && npm run data:attraction-images && npm run data:describe && npm run data:report",
    "data:attractions": "node scripts/attractions.mjs",
    "data:attraction-images": "node scripts/images.mjs --only=attractions"
  },
  "engines": {
    "node": ">=22.21"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
